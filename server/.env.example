# Copy this file to ".env" (same folder) and fill in your real values.

# Required: get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only needed if you want JARVIS to control real smart home devices
# via Home Assistant (https://www.home-assistant.io/). Leave blank to run in
# simulated mode.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional: change which port the server runs on
PORT=3001
